<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 排除 SharedPreferences：可能含 AI key 等敏感配置，不随云备份/换机迁移带走。
         主设置（settings.json）在外部存储 RWmod/config/，不在此备份范围 -->
    <cloud-backup>
        <include domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
